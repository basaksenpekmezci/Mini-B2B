<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mini B2B</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Mini B2B</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Ürünler</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" asp-controller="Cart" asp-action="Index">Sepetim</a>
                    <a class="nav-link" asp-controller="Orders" asp-action="Index">Siparişlerim</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index">Yönetim Paneli</a>
                }
            </div>
            <div class="navbar-nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-link text-light">Merhaba, @User.Identity!.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link nav-link">Çıkış Yap</button>
                    </form>
                }
                else
                {
                    <a class="nav-link" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                    <a class="nav-link" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                }
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
