@using MiniB2B.Web.Data
@using MiniB2B.Web.Services
@model PagedResult<Product>
@{
    ViewData["Title"] = "Ürünler";
    var columns = (List<ProductGridColumn>)ViewData["GridColumns"]!;
    var categories = (IEnumerable<Category>)ViewData["Categories"]!;
    var brands = (IEnumerable<string>)ViewData["Brands"]!;
    var currentCategoryId = ViewData["CategoryId"] as int?;
    var currentMarka = ViewData["Marka"] as string;
    var banners = ((IEnumerable<Banner>)ViewData["Banners"]!).ToList();
    // Görseli olmayan banner'lar için sırayla dönen renk paleti (admin panelinden görsel eklenmese de slider anlamlı görünsün diye).
    string[] bannerColors = { "bg-primary", "bg-success", "bg-dark", "bg-secondary", "bg-info" };
}

@if (banners.Any())
{
    <div id="homeSlider" class="carousel slide mb-4" data-bs-ride="carousel">
        <div class="carousel-inner rounded">
            @for (var i = 0; i < banners.Count; i++)
            {
                var banner = banners[i];
                var slideContent = string.IsNullOrEmpty(banner.ResimUrl)
                    ? $"<div class=\"{bannerColors[i % bannerColors.Length]} text-white text-center py-5\"><h3>{System.Net.WebUtility.HtmlEncode(banner.Baslik)}</h3></div>"
                    : $"<img src=\"{banner.ResimUrl}\" alt=\"{System.Net.WebUtility.HtmlEncode(banner.Baslik)}\" class=\"d-block w-100\" style=\"max-height:320px;object-fit:cover;\" />";

                <div class="carousel-item @(i == 0 ? "active" : "")">
                    @if (!string.IsNullOrEmpty(banner.Link))
                    {
                        <a href="@banner.Link">@Html.Raw(slideContent)</a>
                    }
                    else
                    {
                        @Html.Raw(slideContent)
                    }
                </div>
            }
        </div>
        @if (banners.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#homeSlider" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeSlider" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        }
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Ürünler</h2>
</div>

<form method="get" class="mb-3 row g-2 align-items-center">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control"
               placeholder="Ürün adı, kodu, marka, üretici kodu, açıklama..." style="min-width:300px" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select">
            <option value="">Tüm Kategoriler</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(currentCategoryId == c.Id)">@c.Ad</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="marka" class="form-select">
            <option value="">Tüm Markalar</option>
            @foreach (var b in brands)
            {
                <option value="@b" selected="@(currentMarka == b)">@b</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Ara / Filtrele</button>
    </div>
    @if (!string.IsNullOrEmpty(ViewData["Search"] as string) || currentCategoryId is not null || !string.IsNullOrEmpty(currentMarka))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-link">Temizle</a>
        </div>
    }
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            @foreach (var col in columns)
            {
                <th class="@ProductGridRenderer.ResponsiveClass(col) text-@col.Alignment" style="@(col.Width is null ? "" : $"width:{col.Width}")">
                    @col.DisplayName
                </th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Items)
        {
            <tr>
                @foreach (var col in columns)
                {
                    <td class="@ProductGridRenderer.ResponsiveClass(col) text-@col.Alignment">
                        @switch (col.RenderTypeEnum)
                        {
                            case GridRenderType.Image:
                                var imgUrl = ProductGridRenderer.GetValue(p, col.ColumnKey) as string;
                                if (string.IsNullOrEmpty(imgUrl))
                                {
                                    <div class="bg-light border rounded d-inline-flex align-items-center justify-content-center text-muted" style="width:48px;height:48px;font-size:10px;">Görsel Yok</div>
                                }
                                else
                                {
                                    <img src="@imgUrl" alt="@p.UrunAdi" style="width:48px;height:48px;object-fit:cover;" class="rounded border" />
                                }
                                break;

                            case GridRenderType.Currency:
                                var price = ProductGridRenderer.GetValue(p, col.ColumnKey) as decimal?;
                                @($"{price:N2} TL")
                                break;

                            case GridRenderType.StockBadge:
                                <span class="badge @ProductGridRenderer.StockBadgeClass(p.StokDurumu)">@p.StokDurumu</span>
                                break;

                            case GridRenderType.QtyInput:
                                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-1 justify-content-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.Id" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <input type="number" name="adet" value="1" min="1" class="form-control form-control-sm" style="width:70px" disabled="@(p.StokMiktari <= 0)" />
                                    <button type="submit" class="btn btn-sm btn-primary" disabled="@(p.StokMiktari <= 0)">Sepete Ekle</button>
                                </form>
                                break;

                            default:
                                @ProductGridRenderer.GetValue(p, col.ColumnKey)
                                break;
                        }
                    </td>
                }
                <td class="text-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-product-detail" data-product-id="@p.Id">Detay</button>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="@(columns.Count + 1)" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Sayfalama" class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Toplam @Model.TotalCount kayıt — Sayfa @Model.Page / @Model.TotalPages</span>
        <ul class="pagination mb-0">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-search="@ViewData["Search"]" asp-route-categoryId="@currentCategoryId"
                       asp-route-marka="@currentMarka" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}

<div class="modal fade" id="productDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Ürün Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="productDetailModalBody">
                <div class="text-center text-muted py-4">Yükleniyor...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js"></script>
}
