@model Cart
@{ ViewData["Title"] = "Sepetim"; }

<h2 class="mb-4">Sepetim</h2>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        Sepetinizde ürün bulunmuyor. <a asp-controller="Home" asp-action="Index">Ürünlere göz atın</a>.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Ürün</th>
                <th class="text-end">Birim Fiyat</th>
                <th class="text-center" style="width:160px">Adet</th>
                <th class="text-end">Toplam</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <div class="fw-semibold">@item.UrunAdi</div>
                        <div class="text-muted small">@item.UrunKodu</div>
                        @if (item.Adet > item.MevcutStok)
                        {
                            <div class="text-danger small">Mevcut stok: @item.MevcutStok — sipariş sırasında adet stoğu aşarsa reddedilecektir.</div>
                        }
                    </td>
                    <td class="text-end">@item.BirimFiyat.ToString("N2") TL</td>
                    <td class="text-center">
                        <form asp-action="UpdateQuantity" method="post" class="d-flex gap-1 justify-content-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <input type="number" name="adet" value="@item.Adet" min="1" class="form-control form-control-sm" style="width:70px" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Güncelle</button>
                        </form>
                    </td>
                    <td class="text-end">@item.ToplamFiyat.ToString("N2") TL</td>
                    <td class="text-end">
                        <form asp-action="Remove" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Çıkar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="3" class="text-end">Sepet Toplamı</th>
                <th class="text-end">@Model.Toplam.ToString("N2") TL</th>
                <th></th>
            </tr>
        </tfoot>
    </table>

    <form asp-action="Checkout" method="post" class="text-end">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success btn-lg">Sipariş Oluştur</button>
    </form>
}
