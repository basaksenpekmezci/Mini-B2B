@model IEnumerable<Product>
@{ ViewData["Title"] = "Ürünler"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Ürünler</h2>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Ürün</a>
</div>

<form method="get" class="mb-3 row g-2">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Ürün adı, kodu, marka, açıklama..." style="min-width:320px" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
    </div>
    @if (!string.IsNullOrEmpty(ViewData["Search"] as string))
    {
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-link">Temizle</a>
        </div>
    }
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Ürün Kodu</th>
            <th>Ürün Adı</th>
            <th>Marka</th>
            <th>Kategori</th>
            <th class="text-end">Stok</th>
            <th class="text-end">Fiyat</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.UrunKodu</td>
                <td>@p.UrunAdi</td>
                <td>@p.Marka</td>
                <td>@p.CategoryAdi</td>
                <td class="text-end">@p.StokMiktari</td>
                <td class="text-end">@p.Fiyat.ToString("N2") TL</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted py-4">Kayıt bulunamadı.</td></tr>
        }
    </tbody>
</table>
