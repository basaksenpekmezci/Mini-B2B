@model Product

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="UrunKodu" class="form-label"></label>
        <input asp-for="UrunKodu" class="form-control" required />
    </div>
    <div class="col-md-8 mb-3">
        <label asp-for="UrunAdi" class="form-label"></label>
        <input asp-for="UrunAdi" class="form-control" required />
    </div>
</div>

<div class="mb-3">
    <label asp-for="Aciklama" class="form-label"></label>
    <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Marka" class="form-label"></label>
        <input asp-for="Marka" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="UreticiKodu" class="form-label"></label>
        <input asp-for="UreticiKodu" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label class="form-label">Kategori</label>
        <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList((IEnumerable<Category>)ViewBag.Categories, "Id", "Ad"))">
            <option value="">-- Seçiniz --</option>
        </select>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="OzelKod1" class="form-label"></label>
        <input asp-for="OzelKod1" class="form-control" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="OzelKod2" class="form-label"></label>
        <input asp-for="OzelKod2" class="form-control" />
    </div>
</div>

<div class="mb-3">
    <label asp-for="ResimUrl" class="form-label">Resim URL</label>
    <input asp-for="ResimUrl" class="form-control" placeholder="/images/products/... veya harici URL" />
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="StokMiktari" class="form-label"></label>
        <input asp-for="StokMiktari" type="number" min="0" class="form-control" required />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="KritikStokSeviyesi" class="form-label">Kritik Stok Seviyesi</label>
        <input asp-for="KritikStokSeviyesi" type="number" min="0" class="form-control" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Fiyat" class="form-label"></label>
        <input asp-for="Fiyat" type="number" min="0" step="0.01" class="form-control" required />
    </div>
</div>
