<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-secondary mb-4">
        <div class="container">
            <a class="navbar-brand" asp-area="Admin" asp-controller="Products" asp-action="Index">Mini B2B — Yönetim Paneli</a>
            <div class="navbar-nav me-auto">
                <a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index">Ürünler</a>
                <a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index">Kullanıcılar</a>
                <a class="nav-link" asp-area="Admin" asp-controller="Orders" asp-action="Index">Siparişler</a>
                <a class="nav-link" asp-area="Admin" asp-controller="GridColumns" asp-action="Index">Grid Kolonları</a>
                <a class="nav-link" asp-area="Admin" asp-controller="Banners" asp-action="Index">Banner'lar</a>
            </div>
            <div class="navbar-nav">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Mağazaya Dön</a>
            </div>
        </div>
    </nav>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
