@model IEnumerable<Order>
@{ ViewData["Title"] = "Siparişler"; }

<h2 class="mb-4">Siparişler</h2>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Sipariş No</th>
            <th>Kullanıcı</th>
            <th>Tarih</th>
            <th class="text-end">Toplam Tutar</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.SiparisNo</td>
                <td>@o.KullaniciAdSoyad</td>
                <td>@o.SiparisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                <td class="text-end">@o.ToplamTutar.ToString("N2") TL</td>
                <td><span class="badge @OrderStatusBadge.CssClass(o.Durum)">@OrderStatusBadge.Label(o.Durum)</span></td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Detay</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">Kayıtlı sipariş yok.</td></tr>
        }
    </tbody>
</table>
