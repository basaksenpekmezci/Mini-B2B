@model IEnumerable<User>
@{ ViewData["Title"] = "Kullanıcılar"; }

<h2 class="mb-4">Kullanıcılar</h2>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Kullanıcı Adı</th>
            <th>E-posta</th>
            <th>Telefon</th>
            <th>Kayıt Tarihi</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Ad @u.Soyad</td>
                <td>@u.Username</td>
                <td>@u.Email</td>
                <td>@u.Telefon</td>
                <td>@u.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Görüntüle</a>
                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-4">Kayıtlı kullanıcı yok.</td></tr>
        }
    </tbody>
</table>
